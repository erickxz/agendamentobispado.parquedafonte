# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Nunca faça commit do arquivo com valores reais.

# --- Google Agenda (service account) ---
# Campo "client_email" do JSON da service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=agendamento@seu-projeto.iam.gserviceaccount.com
# Campo "private_key" do JSON, entre aspas, com os \n literais (o código converte em quebras de linha)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Configurações da agenda > Integrar agenda > ID da agenda
GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com

# Só em desenvolvimento: usa uma agenda simulada em memória no lugar do Google (ignorado em produção).
# MOCK_CALENDAR=true

# --- Painel administrativo ---
ADMIN_PASSWORD=troque-por-uma-senha-longa
# Segredo para assinar o cookie de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-de-32-caracteres-ou-mais

# --- Cloudflare Turnstile ---
# Chaves de teste da Cloudflare (sempre aprovam) — use só em desenvolvimento:
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Upstash Redis (rate limit) ---
# Opcional em desenvolvimento: sem estas variáveis o limite é feito em memória.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- E-mail de aviso ao secretário (opcional) ---
# Quando alguém marca, remarca ou cancela, o sistema manda um e-mail. Sem estas variáveis, não envia nada.
# GMAIL_APP_PASSWORD é uma "senha de app" do Google (Conta Google > Segurança > Senhas de app), não a senha normal.
GMAIL_USER=alaparquedafonte@gmail.com
GMAIL_APP_PASSWORD=
# Para quem vão os avisos (pode ser mais de um, separados por vírgula)
NOTIFY_EMAIL_TO=
